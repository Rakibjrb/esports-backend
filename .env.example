# Application Config
NODE_ENV=development
PORT=8001
CORS_ORIGIN=http://localhost:3000

# Database Settings (MongoDB with Replica Set support for transactions)
# Standard local replica set URI example: mongodb://localhost:27017,localhost:27018,localhost:27019/ffairdrop?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/ffairdrop

# Redis configurations (Used for BullMQ and Rate Limiting locks)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Session Token
JWT_SECRET=super_secret_cryptographic_key_replace_this_in_production
JWT_EXPIRES_IN=86400
COOKIE_SECURE=false
