# Application Config
NODE_ENV=development
PORT=8001
CORS_ORIGIN=http://localhost:3000

# Database Settings (MongoDB with Replica Set support for transactions)
# Standard local replica set URI example: mongodb://localhost:27017,localhost:27018,localhost:27019/ffairdrop?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/ffairdrop

# Redis configurations (Used for BullMQ and Rate Limiting locks)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Session Token
JWT_SECRET=super_secret_cryptographic_key_replace_this_in_production
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_SECRET=generate_another_extremely_secure_cryptographic_random_hex_string
JWT_REFRESH_EXPIRES_IN=604800
COOKIE_SECURE=false

# SMTP Mail Configurations (Nodemailer Settings)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="ffairdrop Support" <noreply@ffairdrop.gg>
